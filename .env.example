# --- Приложение ---
# Порт, на котором слушает Node (nginx проксирует сюда по HTTPS)
PORT=3000

# Bearer-токен для доступа к /api/*. Задаётся администратором, не публикуется.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTH_TOKEN=replace-with-long-random-token

# --- База данных (PostgreSQL) ---
# Строка подключения приложения (полные права на учебную таблицу tasks)
DATABASE_URL=postgres://todo_app:app_password@localhost:5432/todo

# Включить SSL для подключения к БД (true для managed-хостингов; false для локального/самостоятельного)
PGSSL=false

# --- Персонализация (берётся из профиля Moodle, НЕ из тела запросов) ---
OWNER_LOGIN=your_moodle_login
OWNER_FULL_NAME=Фамилия Имя Отчество
